# SnappyMail Configuration
# Copy these settings to your .env file

# SnappyMail URLs
SNAPPYMAIL_URL=/mail
SNAPPYMAIL_ADMIN_URL=/mail/?admin

# SSO Configuration (IMPORTANT: Change this!)
# Generate with: php artisan key:generate or openssl rand -base64 32
SNAPPYMAIL_SSO_KEY=

# Admin Password (CHANGE AFTER FIRST LOGIN!)
SNAPPYMAIL_ADMIN_PASSWORD=12345

# Features
SNAPPYMAIL_SSO_ENABLED=true
SNAPPYMAIL_DIRECT_LOGIN=true
SNAPPYMAIL_ADMIN_ACCESS=true
SNAPPYMAIL_USER_CONFIG=true
SNAPPYMAIL_ENCRYPT_PASSWORDS=true

# Security
SNAPPYMAIL_REQUIRE_HTTPS=false
SNAPPYMAIL_SESSION_TIMEOUT=3600
SNAPPYMAIL_MAX_ATTACHMENT_SIZE=25

# Logging
SNAPPYMAIL_LOGGING=true
SNAPPYMAIL_LOG_CHANNEL=stack
SNAPPYMAIL_LOG_LEVEL=info

# IMAP Settings (from existing config)
IMAP_HOST=your-imap-server.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=your-email@domain.com
IMAP_PASSWORD=your-password

# SMTP Settings (for sending emails)
MAIL_HOST=your-smtp-server.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-password
